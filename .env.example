# Development environment template
APP_MODE=demo
APP_NAME=Voice Scheduling Agent
LOG_LEVEL=DEBUG
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/app.db
DB_REQUIRE_MIGRATIONS=false

SESSION_COOKIE_NAME=vsa_session
SESSION_COOKIE_MAX_AGE_SECONDS=2592000
SESSION_COOKIE_SECURE=false
SESSION_SECRET_KEY=change-this-in-production
CSRF_COOKIE_NAME=vsa_csrf
CSRF_HEADER_NAME=X-CSRF-Token

ENABLE_LOGS_ENDPOINT=true
ENABLE_DEBUG_ENDPOINTS=true
ADMIN_TOKEN=

DEFAULT_TIMEZONE=America/Montreal
DEFAULT_DURATION_MINUTES=30

# Google OAuth setup
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events

# OpenAI setup
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_WEBRTC_URL=https://api.openai.com/v1/realtime
OPENAI_REALTIME_SESSIONS_URL=https://api.openai.com/v1/realtime/sessions
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=en
OPENAI_REALTIME_INSTRUCTIONS=You are a voice scheduling assistant. Collect name/date/time/optional title, summarize details, and require explicit confirmation before create_calendar_event.
